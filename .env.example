# Copia este archivo a .env y genera la clave con: php artisan key:generate
# En producción, configura valores propios y usa APP_DEBUG=false.
APP_NAME=Aulamate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aulamate
DB_USERNAME=root
DB_PASSWORD=
DB_DUMP_BINARY_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@aulamate.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173
SANCTUM_GUARD=web
SANCTUM_EXPIRATION=1440
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_DECAY_MINUTES=1
GLOBAL_RATE_LIMIT_MAX=120
GLOBAL_RATE_LIMIT_DECAY_MINUTES=1
DEFAULT_STUDENT_PASSWORD=replace-with-a-temporary-password

# Integracion opcional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Integracion opcional: funciones de IA
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# Integracion opcional: notificaciones push
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Credenciales opcionales para Web Push; genera claves VAPID para habilitarlo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT_EMAIL=admin@aulamate.com

VITE_APP_NAME="${APP_NAME}"
